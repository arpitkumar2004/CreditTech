# ==============================================================================
# CreditTech Local Development Environment Preset
# ==============================================================================
# Quickstart for local developers: zero-dependency SQLite storage with mock connectors.
# Copy this file to .env (or .env.development) for zero-setup local development:
#   cp .env.development.example .env
# ==============================================================================

# ── Application Settings ───────────────────────────────────────────────────────
APP_NAME=CreditTech
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database (Local SQLite) ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./credittech.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_STATEMENT_CACHE_SIZE=0
DATABASE_READ_URL=

# ── Security & Authentication ─────────────────────────────────────────────────
SECRET_KEY=dev_secret_key_64_characters_long_for_local_development_testing_only!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PII Field-Level Encryption (AES-256-GCM) ──────────────────────────────────
# 32-byte key base64-encoded for local testing
PII_ENCRYPTION_KEY=dGVzdF9waWlfZW5jcnlwdGlvbl9rZXlfMzJieXRl

# ── Consent Management (DPDP Act 2023) ────────────────────────────────────────
CONSENT_MAX_DURATION_DAYS=365
CONSENT_GENESIS_SALT=credittech-genesis-v1

# ── Mock External Connectors ──────────────────────────────────────────────────
AA_BASE_URL=http://localhost:8001/mock/aa
AA_CLIENT_ID=mock_client_id
AA_CLIENT_SECRET=mock_client_secret
AA_CREDENTIALS_AVAILABLE=false

GEOSPATIAL_BASE_URL=http://localhost:8001/mock/geospatial
GEOSPATIAL_API_KEY=mock_api_key

BUREAU_BASE_URL=http://localhost:8001/mock/bureau
BUREAU_API_KEY=mock_api_key

# ── CORS & Logging ────────────────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=DEBUG
LOG_FORMAT=console
