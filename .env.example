# ==============================================================================
# CreditTech Environment Configuration — Master Reference Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env (or .env.development / .env.production) as needed.
# 2. Never commit actual .env files containing real secrets to version control.
# 3. For local development with SQLite, see .env.development.example.
# 4. For production deployment with PgBouncer & PostgreSQL, see .env.production.example.
# ==============================================================================

# ── Application Settings ───────────────────────────────────────────────────────
APP_NAME=CreditTech
# Environment mode: 'development', 'staging', 'production', 'test'
APP_ENV=development
# Debug mode: true enables detailed error pages and reloaders (NEVER enable in production)
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database (Primary OLTP) ───────────────────────────────────────────────────
# Connection string using asyncpg driver.
# For direct Postgres: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For PgBouncer: postgresql+asyncpg://<user>:<password>@<pgbouncer_host>:6432/<dbname>
# For local SQLite: sqlite+aiosqlite:///./credittech.db
DATABASE_URL=postgresql+asyncpg://credittech:credittech_dev@localhost:6432/credittech
# Log SQL statements (useful in debugging, disable in production for performance/security)
DATABASE_ECHO=false
# Size of the persistent connection pool per worker process
DATABASE_POOL_SIZE=20
# Maximum overflow connections allowed above DATABASE_POOL_SIZE during bursts
DATABASE_MAX_OVERFLOW=10
# Statement cache size: MUST be set to 0 when fronted by PgBouncer in transaction mode
DATABASE_STATEMENT_CACHE_SIZE=0

# ── Database Read Replica (Analytics / Dashboards / Scorecards) ───────────────
# Optional dedicated read-replica endpoint for read-heavy operations.
# Falls back to DATABASE_URL when empty or omitted.
DATABASE_READ_URL=
DATABASE_READ_POOL_SIZE=10
DATABASE_READ_MAX_OVERFLOW=5

# ── Security & Authentication ─────────────────────────────────────────────────
# Cryptographically secure random secret key (minimum 64 characters) used for JWT signing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PII Field-Level Encryption (AES-256-GCM) ──────────────────────────────────
# 32-byte (256-bit) encryption key encoded in base64.
# Used for encrypting sensitive identity fields (Aadhaar, PAN, voter ID, contact info).
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_BASE64_KEY

# ── Consent Management (DPDP Act 2023) ────────────────────────────────────────
# Maximum validity duration in days for electronic consent artifacts
CONSENT_MAX_DURATION_DAYS=365
# Salt for the genesis block in the append-only cryptographic consent hash chain
CONSENT_GENESIS_SALT=credittech-genesis-v1

# ── External Connectors & Digital Public Infrastructure ───────────────────────
# Sahamati Account Aggregator (AA) Gateway
AA_BASE_URL=http://localhost:8001/mock/aa
AA_CLIENT_ID=mock_client_id
AA_CLIENT_SECRET=mock_client_secret
# Flag indicating whether live Sahamati AA credentials are configured (Phase 6 gate)
AA_CREDENTIALS_AVAILABLE=false

# Geospatial & Village Profile Gateway (Bhuvan / LGD / PM GatiShakti)
GEOSPATIAL_BASE_URL=http://localhost:8001/mock/geospatial
GEOSPATIAL_API_KEY=mock_api_key

# Credit Bureau Gateway (CRIF High Mark / Experian / CIBIL)
BUREAU_BASE_URL=http://localhost:8001/mock/bureau
BUREAU_API_KEY=mock_api_key

# ── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# Comma-separated list of allowed origins. Use "*" for open local dev.
# In staging/production, restrict to approved web/mobile client domains.
CORS_ORIGINS=*

# ── Logging & Observability ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: 'console' for colorized human-readable output, 'json' for structured log aggregation
LOG_FORMAT=json
