# CreditTech Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://credittech:credittech_dev@localhost:5432/credittech
DATABASE_ECHO=false

# ── Application ─────────────────────────────────────────────
APP_NAME=CreditTech
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Security ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PII Encryption ──────────────────────────────────────────
PII_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_BASE64_KEY

# ── Consent ─────────────────────────────────────────────────
CONSENT_MAX_DURATION_DAYS=365
CONSENT_GENESIS_SALT=credittech-genesis-v1

# ── External Connectors (mocked in dev) ─────────────────────
AA_BASE_URL=http://localhost:8001/mock/aa
AA_CLIENT_ID=mock_client_id
AA_CLIENT_SECRET=mock_client_secret

GEOSPATIAL_BASE_URL=http://localhost:8001/mock/geospatial
GEOSPATIAL_API_KEY=mock_api_key

BUREAU_BASE_URL=http://localhost:8001/mock/bureau
BUREAU_API_KEY=mock_api_key

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
