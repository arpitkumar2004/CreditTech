# ==============================================================================
# CreditTech Production Environment Configuration Reference
# ==============================================================================
# Production deployment reference for Cloud SQL / AWS RDS with PgBouncer connection pooling.
# NOTE: In production (APP_ENV=production), startup validation will fail if SECRET_KEY
# or PII_ENCRYPTION_KEY are left at insecure placeholder defaults.
# ==============================================================================

# ── Application Settings ───────────────────────────────────────────────────────
APP_NAME=CreditTech
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database (Managed PostgreSQL 16 fronted by PgBouncer) ────────────────────
# Connect to PgBouncer port 6432 with TLS enforcement (?ssl=require)
DATABASE_URL=postgresql+asyncpg://credittech_app:<STRONG_POSTGRES_PASSWORD>@<PGBOUNCER_HOST>:6432/credittech?ssl=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# CRITICAL: Must be 0 for PgBouncer transaction-mode connection pooling
DATABASE_STATEMENT_CACHE_SIZE=0

# ── Database Read Replica (Reporting & Scorecard Analytics) ───────────────────
DATABASE_READ_URL=postgresql+asyncpg://credittech_ro:<STRONG_POSTGRES_PASSWORD>@<PGBOUNCER_HOST>:6432/credittech?ssl=require
DATABASE_READ_POOL_SIZE=15
DATABASE_READ_MAX_OVERFLOW=5

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<MANDATORY_64_CHAR_HEX_OR_URLSAFE_SECRET_DO_NOT_USE_DEFAULT>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── PII Field-Level Encryption (AES-256-GCM) ──────────────────────────────────
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=<MANDATORY_32_BYTE_BASE64_AES_KEY_DO_NOT_USE_DEFAULT>

# ── Consent Management (DPDP Act 2023) ────────────────────────────────────────
CONSENT_MAX_DURATION_DAYS=365
CONSENT_GENESIS_SALT=credittech-genesis-prod-v1

# ── External Connectors (Production Digital Public Infrastructure) ───────────
# Sahamati Account Aggregator (AA) Gateway — Live Production Endpoint
AA_BASE_URL=https://api.sahamati.org.in/v1/aa
AA_CLIENT_ID=<PRODUCTION_SAHAMATI_CLIENT_ID>
AA_CLIENT_SECRET=<PRODUCTION_SAHAMATI_CLIENT_SECRET>
AA_CREDENTIALS_AVAILABLE=true

# Geospatial & Village Profile Gateway (Bhuvan / LGD / PM GatiShakti)
GEOSPATIAL_BASE_URL=https://api.bhuvan.nrsc.gov.in/v1
GEOSPATIAL_API_KEY=<PRODUCTION_BHUVAN_API_KEY>

# Credit Bureau Gateway (CRIF High Mark / Experian / CIBIL)
BUREAU_BASE_URL=https://api.crifhighmark.com/v1/credit-bureau
BUREAU_API_KEY=<PRODUCTION_CRIF_API_KEY>

# ── CORS & Logging ────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.credittech.in,https://admin.credittech.in
LOG_LEVEL=INFO
LOG_FORMAT=json
