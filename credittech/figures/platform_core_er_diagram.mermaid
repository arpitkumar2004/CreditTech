erDiagram
    borrowers ||--o{ consent_records : "grants (1:N)"
    borrowers ||--o{ feature_snapshots : "owns (1:N)"
    consent_records ||--o{ feature_snapshots : "authorizes (1:N)"
    feature_snapshots ||--|| score_results : "evaluates (1:1)"
    borrowers ||--o{ applications : "submits (1:N)"
    score_results ||--|| applications : "qualifies (1:1)"
    applications ||--|| officer_decisions : "decided_by (1:1)"
    applications ||--|| re_handoffs : "dispatches (1:1)"
    borrowers ||--o{ grievance_records : "lodges (1:N)"
    officer_decisions ||--o{ audit_events : "immutable_log (1:N)"

    borrowers {
        uuid id PK "Primary Key"
        string village_id FK "Village cluster code"
        string aadhaar_hash UK "Salted SHA-256 hash"
        string phone_encrypted "AES-256 encrypted"
        string full_name "Borrower name"
        string segment "marginal | small | tenant | shg | micro"
        string gender "Audit only: F | M"
        string caste_category "Audit only: OBC | SC | ST | General"
        string landholding_band "Audit only: <1ha | 1-2ha | 2-4ha"
        datetime created_at "Timestamp"
    }

    consent_records {
        uuid id PK "Primary Key"
        uuid borrower_id FK "Ref borrowers.id"
        string purpose "AGRICULTURAL_CREDIT_UNDERWRITING"
        string status "ACTIVE | REVOKED | EXPIRED"
        string hash_chain UK "SHA-256 tamper-evident link"
        datetime expires_at "Statutory time bound"
        datetime revoked_at "Unilateral revocation timestamp"
    }

    feature_snapshots {
        uuid id PK "Primary Key"
        uuid borrower_id FK "Ref borrowers.id"
        uuid consent_id FK "Ref consent_records.id"
        json features_json "21-Core 5-Cs features vector"
        float completeness_pct "Telemetry completeness ratio"
        datetime created_at "Frozen immutable snapshot"
    }

    score_results {
        uuid id PK "Primary Key"
        uuid feature_id FK "Ref feature_snapshots.id"
        string model_version "v1.1.0-woe-scorecard"
        float pd_score "Default probability (0.0 to 1.0)"
        int scaled_score "Scorecard scale (300 to 900)"
        string decision_zone "REJECT | REVIEW | APPROVE"
        json shap_reasons "Bilingual (Hindi/English) Top-3 factors"
    }

    applications {
        uuid id PK "Primary Key (loan_id)"
        uuid borrower_id FK "Ref borrowers.id"
        uuid score_id FK "Ref score_results.id"
        string product_type "Crop input | SHG-BLP | Micro | Dairy"
        numeric loan_amount "Sanctioned principal (Rs 5k steps)"
        int tenor_months "Maturity (9 to 36 months)"
        string status "PENDING | APPROVED | REJECTED"
        datetime created_at "Origination timestamp"
    }

    officer_decisions {
        uuid id PK "Primary Key"
        uuid application_id FK "Ref applications.id"
        string officer_id "Branch credit underwriter ID"
        string final_verdict "APPROVE | REJECT | REFER"
        boolean is_override "Mandatory override indicator"
        string override_reason "Standard justification code"
        text justification_note "Mandatory auditable rationale"
        datetime decided_at "Immutable decision timestamp"
    }

    re_handoffs {
        uuid id PK "Primary Key"
        uuid application_id FK "Ref applications.id"
        string bank_code "Regional Rural Bank identifier"
        string external_ref_token "Dispatched CBS idempotency token"
        string payload_digest UK "SHA-256 payload integrity digest"
        datetime dispatched_at "Transmission timestamp"
    }

    grievance_records {
        uuid id PK "Primary Key"
        uuid borrower_id FK "Ref borrowers.id"
        string category "DATA_ERROR | SCORING | SERVICE"
        string status "OPEN | IN_REVIEW | RESOLVED"
        datetime sla_deadline "Statutory +30 days regulatory timer"
        datetime resolved_at "Resolution timestamp"
    }

    audit_events {
        uuid id PK "Primary Key"
        string event_type "CONSENT | SCORE | OVERRIDE | HANDOFF"
        string actor_role "BORROWER | SAKHI | OFFICER | ADMIN"
        string actor_id "User identifier"
        string payload_hash "Cryptographic integrity digest"
        datetime timestamp "Append-only trigger guarded"
    }

